# 服务监听与数据目录
LISTEN_ADDR=:8080
DATA_DIR=./data

# 首次启动时创建的管理员。已有数据库不会被覆盖。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password

# 可选：固定用于加密上游 API Key 的主密钥。生产环境建议设置为 32 字节以上随机串。
# 未设置时会在 DATA_DIR/master.key 生成并持久化随机密钥。
MASTER_KEY=

# 在 HTTPS 反向代理后部署时设为 true
COOKIE_SECURE=false
TRUSTED_PROXIES=

# 可选：服务启动时写入默认上游账号（只在账号表为空时生效）
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
